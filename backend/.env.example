# Copiar como .env y completar los valores.

# Puerto de la API.
PORT=3001

# Origen permitido por CORS (la aplicación web).
FRONTEND_URL=http://localhost:3000

# Conexión a PostgreSQL, local o de Supabase. Se usa cuando el backend se conecte a la base.
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/utn_match
