# Copiar como .env y completar los valores. Todas las variables son opcionales en desarrollo:
# sin ningún valor, la API arranca en el puerto 3001 con una base local (PGlite) ya cargada.

# Entorno: development | test | production. Sin definir se asume desarrollo.
# NODE_ENV=development

# Puerto de la API.
PORT=3001

# Origen permitido por CORS (la aplicación web). Varios orígenes, separados por coma.
FRONTEND_URL=http://localhost:3000

# --- Base de datos ---------------------------------------------------------------------------
# Conexión a PostgreSQL, local o de Supabase. Si se deja vacía, el backend usa PGlite
# (PostgreSQL embebido, sin instalar nada) y guarda los datos en PGLITE_DATA_DIR.
DATABASE_URL=
# Poner true si el servidor PostgreSQL exige SSL (Supabase, Render).
DATABASE_SSL=false
# Carpeta de la base local de PGlite. `memory://` la deja solo en memoria.
PGLITE_DATA_DIR=.data/pglite
# Si la base está vacía, aplicar database/schema.sql y database/seed.sql al arrancar.
# Por defecto es true fuera de producción y false en producción. Está comentada a propósito:
# el seed trae usuarios con una contraseña pública, así que en producción se activa solo
# en el primer despliegue (ver docs/DEPLOY.md) y después se vuelve a false.
# DB_AUTO_INIT=true

# --- Seguridad -------------------------------------------------------------------------------
# Secreto para firmar los JWT (al menos 32 caracteres). Obligatorio en producción. Fuera de
# producción, si falta, se genera uno al azar en cada arranque (las sesiones no sobreviven
# a un reinicio). Generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duración de la sesión, en horas.
JWT_EXPIRES_IN_HOURS=12
# Costo de bcrypt para las contraseñas (4 a 15). Más alto es más lento y más seguro.
BCRYPT_COST=10
# Límite de pedidos a /api/auth/* por IP: máximo de pedidos y ventana en segundos.
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# Cantidad de proxies delante de la API (Render, Vercel, nginx): sirve para ver la IP real.
# Con 0 no se confía en ninguno.
TRUST_PROXY=0
